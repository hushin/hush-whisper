# Configuration for bindgen to find libclang and system headers
# Copy this file to config.toml and adjust paths for your environment
#
# To find your paths:
#   LLVM: where libclang.dll is located (usually C:/Program Files/LLVM/bin)
#   MSVC: dir "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC"
#   Windows SDK: dir "C:/Program Files (x86)/Windows Kits/10/Include"

[env]
LIBCLANG_PATH = "C:/Program Files/LLVM/bin"
BINDGEN_EXTRA_CLANG_ARGS = "-I'C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/include' -I'C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt'"
# Host compiler for nvcc (candle CUDA kernels). bindgen_cuda passes this to `nvcc -ccbin`.
# Point at the MSVC cl.exe directory (Hostx64\x64); required when cl.exe is not on PATH.
# NVCC_CCBIN = "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64"
#
# --- Required when building with the `cuda` feature (candle + tokenizers + whisper-rs) ---
# Force the dynamic CRT (/MD) to match whisper-rs and Rust's default. esaxx-rs
# (tokenizers) hardcodes static CRT and candle's nvcc objects default to it too,
# which otherwise fails at link time (LNK2038 mismatch).
# CFLAGS = "/MD"
# CXXFLAGS = "/MD"
# NVCC_PREPEND_FLAGS = "-Xcompiler=/MD"
# Point cudarc/libcublasLt at your CUDA install.
# CUDA_PATH = "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.0"
# cudarc's cuda-13000 bindings reference cublasLtEmulationDesc* which CUDA 13.0's
# cublasLt.lib does not export. Pin cudarc to the 12.9 bindings (the 13.0 import
# lib is a superset) to avoid unresolved-symbol link errors.
# CUDARC_CUDA_VERSION = "12090"
