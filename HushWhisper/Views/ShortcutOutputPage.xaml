<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HushWhisper.Views.ShortcutOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HushWhisper.Models">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="ショートカット・出力" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="録音の開始/停止ショートカット" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="下のボックスをクリックしてから、設定したいキーの組み合わせを押してください。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="ShortcutBox"
                             Width="320"
                             HorizontalAlignment="Left"
                             IsReadOnly="True"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="Ctrl+Space"
                             Text="{x:Bind ViewModel.Shortcut, Mode=OneWay}"
                             KeyDown="ShortcutBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="出力先" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons ItemsSource="{x:Bind ViewModel.OutputModes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedOutputMode, Mode=TwoWay}">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate x:DataType="models:OutputModeOption">
                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
