<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HushWhisper.Views.LlmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="LLM（文章整形）" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="LLM による文章整形を有効にする"
                                  IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />

                    <ComboBox Header="プロバイダー"
                              ItemsSource="{x:Bind ViewModel.Providers}"
                              SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              MinWidth="280" />

                    <TextBox Header="API URL"
                             Text="{x:Bind ViewModel.ApiUrl, Mode=TwoWay}" />

                    <TextBox Header="モデル名"
                             Text="{x:Bind ViewModel.ModelName, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="プロンプト" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Presets}"
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              MinWidth="280" />
                    <TextBox Header="カスタムプロンプト"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="160"
                             Text="{x:Bind ViewModel.CustomPrompt, Mode=TwoWay}"
                             IsEnabled="{x:Bind ViewModel.IsCustomPreset, Mode=OneWay}" />
                    <TextBlock Text="「{input}」が音声認識結果に置き換えられます。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="接続確認" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
