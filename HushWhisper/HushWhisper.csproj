<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>HushWhisper</RootNamespace>
    <AssemblyName>HushWhisper</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MVVM Toolkit 8.4 の部分プロパティ生成は preview 言語バージョンで有効化される -->
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="*" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="*" />
    <PackageReference Include="Whisper.net.Runtime" Version="*" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="*" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="*" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Visual C++ ランタイムをアプリローカルで同梱する。
    whisper.dll / ggml-cuda-whisper.dll が VCRUNTIME140.dll / VCRUNTIME140_1.dll /
    MSVCP140.dll を要求するため、配布先で別途インストール不要にする。
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="$(SystemRoot)\System32\vcruntime140.dll" Link="vcruntime140.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(SystemRoot)\System32\vcruntime140.dll')" />
    <None Include="$(SystemRoot)\System32\vcruntime140_1.dll" Link="vcruntime140_1.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(SystemRoot)\System32\vcruntime140_1.dll')" />
    <None Include="$(SystemRoot)\System32\msvcp140.dll" Link="msvcp140.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(SystemRoot)\System32\msvcp140.dll')" />
  </ItemGroup>

</Project>
